msgstr "추출할 첫 번째 비트의 인덱스입니다."

msgid "param bits"
msgstr "매개변수"

msgid "The number of bits to extract."
msgstr "오류의 행 번호"

msgid "Integer with the requested bits."
msgstr "요청된 비트가 포함된 정수입니다."

msgid ""
"https://www.khronos.org/registry/OpenGL-Refpages/gl4/html/"
"bitfieldExtract.xhtml"
msgstr ""
"https://www.khronos.org/registry/OpenGL-Refpages/gl4/html/"
"bitfieldExtract.xhtml"

