msgstr ""
"Largura alvo da linha em pixels, adicione ``%`` ao final do valor para "
"especificá-la como porcentagem da largura do controle no lugar de pixels."

msgid "``left`` (or ``l``), ``center`` (or ``c``), ``right`` (or ``r``)"
msgstr "``left`` (ou ``l``), ``center`` (ou ``c``), ``right`` (ou ``r``)"

msgid "``center``"
msgstr "``center``"

msgid "Horizontal alignment."
msgstr "Alinhamento horizontal."

msgid "URL options"
msgstr "Opções de URL"

msgid "**underline**"
msgstr "**underline**"

msgid "``always``, ``never``, ``hover``"
msgstr "``always``, ``never``, ``hover``"

