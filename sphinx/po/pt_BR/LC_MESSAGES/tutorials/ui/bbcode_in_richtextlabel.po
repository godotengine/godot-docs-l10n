msgstr "Opções de regra horizontal"

msgid "Color name or color in HEX format"
msgstr "Nome da cor ou cor no formato HEX"

msgid "``Color(1, 1, 1, 1)``"
msgstr "``Color(1, 1, 1, 1)``"

msgid "Color tint of the rule (modulation)."
msgstr "Tonalidade de cor da linha (modulação)."

msgid "**height**"
msgstr "**height**"

msgid "Integer number"
msgstr "Número inteiro"

msgid "``2``"
msgstr "``2``"

msgid ""
"Target height of the rule in pixels, add ``%`` to the end of value to "
"specify it as percentages of the control width instead of pixels."
msgstr ""
"Altura alvo da linha em pixels, adicione ``%`` ao final do valor para "
"especificá-la como porcentagem da largura do controle no lugar de pixels."

msgid "**width**"
msgstr "**width**"

msgid "``90%``"
msgstr "``90%``"

