msgstr ":ref:`unpackSnorm2x16<shader_func_unpackSnorm2x16>`\\ (\\ uint v)"

msgid ""
"Convert two signed normalized (range -1..1) 32-bit floats to 16-bit signed "
"ints and pack them."
msgstr ""
"Converte dois floats de 32 bits normalizados com sinal (intervalo -1..1) "
"para inteiros sinalizados de 16 bits e os empacota."

msgid ":ref:`packUnorm4x8<shader_func_packUnorm4x8>`\\ (\\ vec4 v)"
msgstr ":ref:`packUnorm4x8<shader_func_packUnorm4x8>`\\ (\\ vec4 v)"

