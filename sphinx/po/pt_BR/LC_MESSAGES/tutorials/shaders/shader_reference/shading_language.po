msgstr "**Vector4i**"

msgid "**Vector2**"
msgstr "**Vector2**"

msgid "**Vector3**, **Color**"
msgstr "**Vector3**, **Color**"

msgid "When Color is used, it will be interpreted as (r, g, b)."
msgstr "Quando Color for usado, será interpretado como (r, g, b)."

msgid "**Vector4**, **Color**, **Rect2**, **Plane**, **Quaternion**"
msgstr "**Vector4**, **Color**, **Rect2**, **Plane**, **Quaternion**"

msgid "When Color is used, it will be interpreted as (r, g, b, a)."
msgstr "Quando Color for usado, será interpretado como (r, g, b, a)."

msgid ""
"When Rect2 is used, it will be interpreted as (position.x, position.y, "
"size.x, size.y)."
msgstr ""
"Quando Rect2 for usado, será interpretado como (position.x, position.y, "
"size.x, size.y)."

msgid ""
"When Plane is used it will be interpreted as (normal.x, normal.y, normal.z, "
"d)."
msgstr ""
"Quando Plane for usado, será interpretado como (normal.x, normal.y, "
"normal.z, d)."

