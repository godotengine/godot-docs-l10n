msgid "Locale codes"
msgstr "Códigos de localidade"

msgid ""
"Locale code has the following format: ``language_Script_COUNTRY_VARIANT``, "
"where:"
msgstr ""
"O código de localidade possui o seguinte formato: "
"``idioma_Script_PAIS_VARIANTE``, onde:"

msgid "``language`` - 2 or 3-letter language code, in lower case."
msgstr "``idioma`` - código de idioma de 2 ou 3 letras, em letras minúsculas."

msgid "``Script`` - optional, 4-letter script code, in title case."
msgstr ""
"``Script`` - opcional, código de escrita de 4 letras, com a primeira letra "
"maiúscula."

msgid "``COUNTRY`` - optional, 2-letter country code, in upper case."
msgstr "``PAIS`` - opcional, código de país de 2 letras, em letras maiúsculas."

msgid ""
"``VARIANT`` - optional, language variant, region and, sort order. A variant "
"can have any number of underscored keywords."
msgstr ""
"``VARIANTE`` - opcional, variante do idioma, região e ordem de "
"classificação. Uma variante pode ter qualquer número de palavras-chave "
"separadas por sublinhado."

