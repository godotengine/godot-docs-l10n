msgstr "WAV com compressão IMA-ADPCM opcional."

msgid "Ogg Vorbis."
msgstr "Ogg Vorbis."

msgid "MP3."
msgstr "MP3."

msgid "*3D scenes:* See :ref:`doc_importing_3d_scenes`."
msgstr "*Cenas 3D:* Veja :ref:`doc_importing_3d_scenes`."

msgid "glTF 2.0 *(recommended)*."
msgstr "glTF 2.0 *(recomendado)*."

msgid ""
"``.blend`` (by calling Blender's glTF export functionality transparently)."
msgstr ""
"`.blend` (chamando a funcionalidade de exportação gITF do Belnder de forma "
