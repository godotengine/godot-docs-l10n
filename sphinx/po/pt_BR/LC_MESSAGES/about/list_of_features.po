msgstr "Disposição em Pilha :ref:`(Layouts Stack) <class_BoxContainer>`."

msgid ":ref:`Grid <class_GridContainer>` layouts."
msgstr "Disposição em Gride :ref:`(Layouts Grid) <class_GridContainer>`."

msgid ""
":ref:`Flow <class_FlowContainer>` layouts (similar to autowrapping text)."
msgstr ""
":ref:`Flow <class_FlowContainer>` layouts (semelhantes ao texto de "
