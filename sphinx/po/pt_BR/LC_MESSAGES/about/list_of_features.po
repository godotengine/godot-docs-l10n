msgid ""
"Support for :ref:`procedural audio generation <class_AudioStreamGenerator>`."
msgstr ""
"Suporte para :ref:`geração de áudio procedural <class_AudioStreamGenerator>`."

msgid "Audio input to record microphones."
msgstr "Entrada de áudio para gravar microfones."

msgid "MIDI input."
msgstr "Entrada MIDI."

msgid "No support for MIDI output yet."
msgstr "Sem suporte para saída MIDI por enquanto."

msgid "**APIs used:**"
msgstr "**APIs utilizadas:**"

msgid "*Windows:* WASAPI."
msgstr "*Windows:* WASAPI."

msgid "*macOS:* CoreAudio."
msgstr "*macOS:* CoreAudio."

msgid "*Linux:* PulseAudio or ALSA."
msgstr "*Linux:* PulseAudio ou ALSA."

