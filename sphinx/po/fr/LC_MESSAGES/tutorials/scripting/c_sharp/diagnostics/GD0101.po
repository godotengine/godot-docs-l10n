msgid "GD0101: The exported member is static"
msgstr "GD0101 : Le membre exporté est statique"

msgid "**Rule ID**"
msgstr "**Rule ID**"

msgid "GD0101"
msgstr "GD0101"

msgid "**Category**"
msgstr "**Catégorie**"

msgid "Usage"
msgstr "Utilisation"

msgid "**Enabled by default**"
msgstr "**Activé par défaut**"

msgid "Yes"
msgstr "Oui"

