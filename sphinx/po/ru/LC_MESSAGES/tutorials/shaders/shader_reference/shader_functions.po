msgstr "Арк-гиперболический тангенс ``x``."

msgid "https://www.khronos.org/registry/OpenGL-Refpages/gl4/html/atanh.xhtml"
msgstr "https://www.khronos.org/registry/OpenGL-Refpages/gl4/html/atanh.xhtml"

