msgstr "touchpad_y"

msgid "Finger movement on the touchpad in the Y direction"
msgstr "在触控板上进行沿Y轴方向的手指移动"

msgid "touchpad"
msgstr "touchpad"

msgid "Vector2"
msgstr "Vector2"

