msgid "Blit built-ins"
msgstr ""

#: ../../docs/tutorials/shaders/shader_reference/texture_blit_shader.rst:79
msgid "Source textures"
msgstr ""

#: ../../docs/tutorials/shaders/shader_reference/texture_blit_shader.rst:81
msgid "Texture blit shaders have up to 4 source textures bound as inputs. These can be accessed with a ``sampler2D`` using ``hint_blit_source0``, ``hint_blit_source1``, ``hint_blit_source2``, and ``hint_blit_source3``."
msgstr ""

#: ../../docs/tutorials/shaders/shader_reference/texture_blit_shader.rst:88
msgid "in vec4 **FRAGCOORD**"
msgstr ""

#: ../../docs/tutorials/shaders/shader_reference/texture_blit_shader.rst:88
msgid "Coordinate of pixel center. In screen space. ``xy`` specifies position in viewport. Upper-left of the viewport is the origin, ``(0.0, 0.0)``."
msgstr ""

#: ../../docs/tutorials/shaders/shader_reference/texture_blit_shader.rst:92
msgid "in vec2 **UV**"
msgstr ""

#: ../../docs/tutorials/shaders/shader_reference/texture_blit_shader.rst:92
msgid "UV from the ``vertex()`` function. This is set to sample all of a source texture."
msgstr ""

