msgstr ""

#: ../../docs/tutorials/shaders/shader_reference/spatial_shader.rst:120
msgid "X-Ray: Display a mesh behind other objects."
msgstr ""

#: ../../docs/tutorials/shaders/shader_reference/spatial_shader.rst:121
