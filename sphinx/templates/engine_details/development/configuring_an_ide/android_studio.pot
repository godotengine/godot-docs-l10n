#: ../../docs/engine_details/development/configuring_an_ide/android_studio.rst:31
msgid "**lib** module:"
msgstr ""

#: ../../docs/engine_details/development/configuring_an_ide/android_studio.rst:33
msgid "Located under ``<Godot root directory>/platform/android/java/lib``, this is a **library module** that organizes the Godot java and native code and make it available as a reusable `Android library <https://developer.android.com/studio/projects/android-library>`_."
msgstr ""

#: ../../docs/engine_details/development/configuring_an_ide/android_studio.rst:34
msgid "The generated :ref:`Godot Android library <doc_android_library>` is made available for other Android modules / projects via `MavenCentral <https://central.sonatype.com/artifact/org.godotengine/godot>`_, along with `its documentation <https://javadoc.io/doc/org.godotengine/godot/latest/index.html>`_."
msgstr ""

#: ../../docs/engine_details/development/configuring_an_ide/android_studio.rst:36
msgid "**editor** module:"
msgstr ""

#: ../../docs/engine_details/development/configuring_an_ide/android_studio.rst:38
msgid "Located under ``<Godot root directory>/platform/android/java/editor``, this is an **application module** that holds the source code for the `Android and XR ports <https://godotengine.org/download/android/>`_ of the Godot Editor."
msgstr ""

#: ../../docs/engine_details/development/configuring_an_ide/android_studio.rst:39
#: ../../docs/engine_details/development/configuring_an_ide/android_studio.rst:44
msgid "This module has a dependency on the **lib** module."
msgstr ""

#: ../../docs/engine_details/development/configuring_an_ide/android_studio.rst:41
msgid "**app** module:"
msgstr ""

#: ../../docs/engine_details/development/configuring_an_ide/android_studio.rst:43
msgid "Located under ``<Godot root directory>/platform/android/java/app``, this is an **application module** that holds the source code for the Android build templates."
msgstr ""

