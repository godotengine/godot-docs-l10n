msgid "(0, 0, 0)"
msgstr "(0, 0, 0)"

#: ../../docs/tutorials/3d/procedural_geometry/arraymesh.rst:334
msgid "(0, 0)"
msgstr "(0, 0)"

#: ../../docs/tutorials/3d/procedural_geometry/arraymesh.rst:335
#: ../../docs/tutorials/3d/procedural_geometry/arraymesh.rst:340
#: ../../docs/tutorials/3d/procedural_geometry/arraymesh.rst:345
#: ../../docs/tutorials/3d/procedural_geometry/arraymesh.rst:350
