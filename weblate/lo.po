#: ../../docs/tutorials/scripting/c_sharp/c_sharp_variant.rst:125
msgid "``int[]``"
msgstr "``int[]``"

#: ../../docs/tutorials/scripting/c_sharp/c_sharp_collections.rst:82
#: ../../docs/tutorials/scripting/c_sharp/c_sharp_variant.rst:126
