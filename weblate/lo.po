#: ../../docs/about/list_of_features.rst:828
msgid "Support for animating any property with customizable interpolation."
msgstr ""
"ຮອງຮັບການເຮັດແອນິເມຊັນໃຫ້ກັບທຸກຄຸນສົມບັດ ພ້ອມການປັບແຕ່ງການແຊກຄ່າ (interpolation)."

#: ../../docs/about/list_of_features.rst:829
msgid "Support for calling methods in animation tracks."
msgstr "ຮອງຮັບການເອີ້ນໃຊ້ເມທອດ (methods) ໃນແທຣັກແອນິເມຊັນ."

#: ../../docs/about/list_of_features.rst:830
msgid "Support for playing sounds in animation tracks."
msgstr "ຮອງຮັບການຫຼິ້ນສຽງໃນແທຣັກແອນິເມຊັນ."

#: ../../docs/about/list_of_features.rst:831
msgid "Support for Bézier curves in animation."
msgstr "ຮອງຮັບເສັ້ນໂຄ້ງ Bézier ໃນແອນິເມຊັນ."

#: ../../docs/about/list_of_features.rst:834
msgid "File formats"
msgstr "ຮູບແບບໄຟລ໌"

#: ../../docs/about/list_of_features.rst:836
msgid ""
"Scenes and resources can be saved in :ref:`text-based "
"<doc_tscn_file_format>` or binary formats."
msgstr ""
"ສາກ (Scenes) ແລະ ຊັບພະຍາກອນ (resources) ສາມາດບັນທຶກໃນຮູບແບບ :ref:`ຂໍ້ຄວາມ (text-"
"based) <doc_tscn_file_format>` ຫຼື ຮູບແບບໄບນາຣີ."

#: ../../docs/about/list_of_features.rst:838
msgid ""
"Text-based formats are human-readable and more friendly to version control."
msgstr ""
"ຮູບແບບຂໍ້ຄວາມສາມາດອ່ານໄດ້ດ້ວຍຕາເປົ່າ ແລະ ເໝາະສຳລັບລະບົບຄວບຄຸມເວີຊັນ (version control)."

#: ../../docs/about/list_of_features.rst:839
msgid "Binary formats are faster to save/load for large scenes/resources."
msgstr ""
"ຮູບແບບໄບນາຣີຈະບັນທຶກ ແລະ ໂຫຼດໄດ້ໄວກວ່າສຳລັບສາກ ຫຼື ຊັບພະຍາກອນທີ່ມີຂະໜາດໃຫຍ່."

#: ../../docs/about/list_of_features.rst:841
msgid "Read and write text or binary files using :ref:`class_FileAccess`."
msgstr "ອ່ານ ແລະ ຂຽນໄຟລ໌ຂໍ້ຄວາມ ຫຼື ໄບນາຣີໂດຍໃຊ້ :ref:`class_FileAccess`."

#: ../../docs/about/list_of_features.rst:843
msgid "Can optionally be compressed or encrypted."
msgstr "ສາມາດເລືອກບີບອັດ ຫຼື ເຂົ້າລະຫັດໄຟລ໌ໄດ້."

#: ../../docs/about/list_of_features.rst:845
msgid "Read and write :ref:`class_JSON` files."
msgstr "ອ່ານ ແລະ ຂຽນໄຟລ໌ :ref:`class_JSON`."

#: ../../docs/about/list_of_features.rst:846
msgid ""
"Read and write INI-style configuration files using :ref:`class_ConfigFile`."
msgstr "ອ່ານ ແລະ ຂຽນໄຟລ໌ການຕັ້ງຄ່າແບບ INI ໂດຍໃຊ້ :ref:`class_ConfigFile`."

#: ../../docs/about/list_of_features.rst:848
msgid "Can (de)serialize any Godot datatype, including Vector2/3, Color, ..."
msgstr ""
"ສາມາດແປງຂໍ້ມູນ (serialize/deserialize) ປະເພດຂໍ້ມູນໃດກໍໄດ້ຂອງ Godot, ລວມທັງ Vector2/3, "
"Color, ..."

#: ../../docs/about/list_of_features.rst:850
msgid "Read XML files using :ref:`class_XMLParser`."
msgstr "ອ່ານໄຟລ໌ XML ໂດຍໃຊ້ :ref:`class_XMLParser`."

#: ../../docs/about/list_of_features.rst:851
msgid ""
":ref:`Load and save images, audio/video, fonts and ZIP archives "
"<doc_runtime_loading_and_saving>` in an exported project without having to "
"go through Godot's import system."
msgstr ""
":ref:`ໂຫຼດ ແລະ ບັນທຶກຮູບພາບ, ສຽງ/ວິດີໂອ, ຟອນ ແລະ ໄຟລ໌ ZIP "
"<doc_runtime_loading_and_saving>` ໃນໂປຣເຈັກທີ່ເອັກສະປອດແລ້ວ ໂດຍບໍ່ຕ້ອງຜ່ານລະບົບການນຳເຂົ້"
"າ (import) ຂອງ Godot."

#: ../../docs/about/list_of_features.rst:853
msgid ""
"Pack game data into a PCK file (custom format optimized for fast seeking), "
"into a ZIP archive, or directly into the executable for single-file "
"distribution."
msgstr ""
"ລວມຂໍ້ມູນເກມເຂົ້າໃນໄຟລ໌ PCK (ຮູບແບບທີ່ຖືກປັບແຕ່ງມາເພື່ອການຄົ້ນຫາທີ່ໄວ), ໃນໄຟລ໌ ZIP ຫຼື ລວມເຂົ້າໃນໄຟລ໌"
"ແລ່ນ (executable) ໂດຍກົງສຳລັບການແຈກຢາຍແບບໄຟລ໌ດຽວ."

#: ../../docs/about/list_of_features.rst:855
msgid ""
":ref:`Export additional PCK files<doc_exporting_pcks>` that can be read by "
"the engine to support mods and DLCs."
msgstr ""
":ref:`ເອັກສະປອດໄຟລ໌ PCK ເພີ່ມເຕີມ <doc_exporting_pcks>` ທີ່ເອນຈິນສາມາດອ່ານໄດ້ເພື່ອຮອງຮັບມອ"
"ດ (mods) ແລະ DLCs."

#: ../../docs/about/list_of_features.rst:859
#: ../../docs/about/docs_changelog.rst:587
msgid "Miscellaneous"
msgstr "ເບັດເຕັລັດ (ອື່ນໆ)"

#: ../../docs/about/list_of_features.rst:861
msgid ""
":ref:`Video playback <doc_playing_videos>` with built-in support for Ogg "
"Theora."
msgstr ":ref:`ການຫຼິ້ນວິດີໂອ <doc_playing_videos>` ພ້ອມຮອງຮັບ Ogg Theora ໃນຕົວ."

#: ../../docs/about/list_of_features.rst:862
msgid ""
":ref:`Movie Maker mode <doc_creating_movies>` to record videos from a "
"running project with synchronized audio and perfect frame pacing."
msgstr ""
":ref:`ໂໝດ Movie Maker <doc_creating_movies>` ເພື່ອບັນທຶກວິດີໂອຈາກໂປຣເຈັກທີ່ກຳລັງແລ່ນ ພ້ອມ"
"ສຽງທີ່ກົງກັນ ແລະ ຈັງຫວະເຟຣມທີ່ສົມບູນແບບ."

#: ../../docs/about/list_of_features.rst:864
msgid ""
":ref:`Low-level access to servers <doc_using_servers>` which allows "
"bypassing the scene tree's overhead when needed."
msgstr ""
":ref:`ການເຂົ້າເຖິງເຊີເວີລະດັບຕ່ຳ <doc_using_servers>` ເຊິ່ງຊ່ວຍໃຫ້ຂ້າມຂັ້ນຕອນການເຮັດວຽກຂອງ "
"scene tree ເມື່ອຈຳເປັນ."

#: ../../docs/about/list_of_features.rst:866
msgid ""
":ref:`Command line interface <doc_command_line_tutorial>` for automation."
msgstr ""
":ref:`ສ່ວນຕິດຕໍ່ແບບຄຳສັ່ງ (Command line interface) <doc_command_line_tutorial>` ສຳລັ"
"ບລະບົບອັດຕະໂນມັດ."

#: ../../docs/about/list_of_features.rst:868
msgid "Export and deploy projects using continuous integration platforms."
msgstr ""
"ເອັກສະປອດ ແລະ ຕິດຕັ້ງໂປຣເຈັກໂດຍໃຊ້ແພລັດຟອມການເຊື່ອມໂຍງແບບຕໍ່ເນື່ອງ (CI)."

#: ../../docs/about/list_of_features.rst:869
msgid ""
"`Shell completion scripts <https://github.com/godotengine/godot/tree/master/"
"misc/dist/shell>`__ are available for Bash, zsh and fish."
msgstr ""
"`ສະຄຣິບຊ່ວຍຕື່ມຄຳສັ່ງ (Shell completion scripts) <https://github.com/godotengine/"
"godot/tree/master/misc/dist/shell>`__ ມີໃຫ້ໃຊ້ສຳລັບ Bash, zsh ແລະ fish."

#: ../../docs/about/list_of_features.rst:871
msgid ""
"Print colored text to standard output on all platforms "
"using :ref:`print_rich <class_@GlobalScope_method_print_rich>`."
msgstr ""
"ສະແດງຂໍ້ຄວາມແບບມີສີອອກທາງ standard output ໃນທຸກແພລັດຟອມໂດຍໃຊ້ :ref:`print_rich "
"<class_@GlobalScope_method_print_rich>`."

#: ../../docs/about/list_of_features.rst:874
msgid ""
"The editor can :ref:`detect features used in a project and create a "
"compilation profile <doc_engine_compilation_configuration_editor>`, which "
"can be used to create smaller export template binaries with unneeded "
"features disabled."
msgstr ""
"ຕົວແກ້ໄຂສາມາດ :ref:`ກວດຫາຟີເຈີທີ່ໃຊ້ໃນໂປຣເຈັກ ແລະ ສ້າງໂປຣໄຟລ໌ການຄອມໄພລ໌ "
"<doc_engine_compilation_configuration_editor>` ເຊິ່ງສາມາດໃຊ້ເພື່ອສ້າງໄຟລ໌ເອັກສະປອດທີ່ມີຂ"
"ະໜາດນ້ອຍລົງ ໂດຍການປິດຟີເຈີທີ່ບໍ່ຈຳເປັນ."

#: ../../docs/about/list_of_features.rst:878
msgid ""
"Support for :ref:`C++ modules <doc_custom_modules_in_cpp>` statically linked "
"into the engine binary."
msgstr ""
"ຮອງຮັບ :ref:`C++ modules <doc_custom_modules_in_cpp>` ທີ່ເຊື່ອມຕໍ່ແບບ static ເຂົ້າໃນໄຟ"
"ລ໌ໄບນາຣີຂອງເອນຈິນ."

#: ../../docs/about/list_of_features.rst:881
msgid ""
"Most built-in modules can be disabled at compile-time to reduce binary size "
"in custom builds. See :ref:`doc_optimizing_for_size` for details."
msgstr ""
"ໂມດູນທີ່ມີມາໃຫ້ສ່ວນໃຫຍ່ສາມາດປິດໄດ້ໃນຂະນະຄອມໄພລ໌ເພື່ອຫຼຸດຂະໜາດໄບນາຣີ. ເບິ່ງ "
":ref:`doc_optimizing_for_size` ສຳລັບລາຍລະອຽດ."

#: ../../docs/about/list_of_features.rst:884
msgid "Engine and editor written in C++17."
msgstr "ເອນຈິນ ແລະ ຕົວແກ້ໄຂຂຽນດ້ວຍ C++17."

#: ../../docs/about/list_of_features.rst:886
msgid ""
"Can be :ref:`compiled <doc_introduction_to_the_buildsystem>` using GCC, "
"Clang and MSVC. MinGW is also supported."
msgstr ""
"ສາມາດ :ref:`ຄອມໄພລ໌ <doc_introduction_to_the_buildsystem>` ໂດຍໃຊ້ GCC, Clang ແລ"
"ະ MSVC. ຮອງຮັບ MinGW ເຊັ່ນກັນ."

#: ../../docs/about/list_of_features.rst:888
msgid ""
"Friendly towards packagers. In most cases, system libraries can be used "
"instead of the ones provided by Godot. The build system doesn't download "
"anything. Builds can be fully reproducible."
msgstr ""
"ເປັນມິດຕໍ່ຜູ້ຈັດທຳແພັກເກດ. ໃນຫຼາຍໆ ກໍລະນີ, ສາມາດໃຊ້ໄລບຣາຣີຂອງລະບົບແທນອັນທີ່ Godot ກຽມໄວ້ໃຫ້ໄດ້. ລ"
"ະບົບການບິວ (build system) ຈະບໍ່ດາວໂຫຼດຫຍັງເພີ່ມ. ການບິວສາມາດເຮັດຊ້ຳໄດ້ຢ່າງສົມບູນ."

#: ../../docs/about/list_of_features.rst:892
msgid "Licensed under the permissive MIT license."
msgstr "ໄດ້ຮັບອະນຸຍາດພາຍໃຕ້ສັນຍາອະນຸຍາດ MIT."

#: ../../docs/about/list_of_features.rst:894
msgid ""
"Open development process with `contributions welcome <https://"
"contributing.godotengine.org/en/latest/organization/"
"how_to_contribute.html>`__."
msgstr ""
"ຂະບວນການພັດທະນາແບບເປີດ ພ້ອມ `ຍິນດີຕ້ອນຮັບຜູ້ທີ່ຢາກຊ່ວຍພັດທະນາ <https://"
"contributing.godotengine.org/en/latest/organization/how_to_contribute.html>"
"`__."

#: ../../docs/about/list_of_features.rst:898
msgid ""
"The `Godot proposals repository <https://github.com/godotengine/godot-"
"proposals>`__ lists features that have been requested by the community and "
"may be implemented in future Godot releases."
msgstr ""
"`ຄັງຂໍ້ສະເໜີຂອງ Godot (Godot proposals repository) <https://github.com/"
"godotengine/godot-proposals>`__ ລວບລວມລາຍການຟີເຈີທີ່ຊຸມຊົນຮ້ອງຂໍມາ ແລະ ອາດຈະຖືກນຳມາໃຊ້ໃ"
"ນເວີຊັນຕໍ່ໆ ໄປ."

#: ../../docs/about/system_requirements.rst:6
msgid "System requirements"
msgstr "ຄວາມຕ້ອງການຂອງລະບົບ"

#: ../../docs/about/system_requirements.rst:8
msgid ""
"This page contains system requirements for the editor and exported projects. "
"These specifications are given for informative purposes only, but they can "
"be referred to if you're looking to build or upgrade a system to use Godot "
"on."
msgstr ""
"ໜ້ານີ້ປະກອບມີຄວາມຕ້ອງການຂອງລະບົບສຳລັບຕົວແກ້ໄຂ ແລະ ໂປຣເຈັກທີ່ເອັກສະປອດອອກໄປ. ຂໍ້ມູນຈຳເພາະເຫຼົ່ານີ້ໃ"
"ຫ້ໄວ້ເພື່ອເປັນຂໍ້ມູນເທົ່ານັ້ນ, ແຕ່ທ່ານສາມາດອ້າງອີງໄດ້ຫາກທ່ານກຳລັງຊອກຫາບິວ ຫຼື ອັບເກຣດລະບົບເພື່ອໃຊ້ "
"Godot."

#: ../../docs/about/system_requirements.rst:13
msgid "Godot editor"
msgstr "ຕົວແກ້ໄຂ Godot"

#: ../../docs/about/system_requirements.rst:15
msgid ""
"These are the **minimum** specifications required to run the Godot editor "
"and work on a simple 2D or 3D project:"
msgstr ""
"ນີ້ຄືຂໍ້ມູນຈຳເພາະ **ຂັ້ນຕ່ຳ** ທີ່ຈຳເປັນໃນການແລ່ນຕົວແກ້ໄຂ Godot ແລະ ເຮັດວຽກໃນໂປຣເຈັກ 2D ຫຼື 3D ແບ"
"ບງ່າຍໆ:"

#: ../../docs/about/system_requirements.rst:19
#: ../../docs/about/system_requirements.rst:204
msgid "Desktop or laptop PC - Minimum"
msgstr "PC ແບບຕັ້ງໂຕະ ຫຼື ແລັບທັອບ - ຂັ້ນຕ່ຳ"

