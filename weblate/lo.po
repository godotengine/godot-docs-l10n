msgid "JetBrains Rider"
msgstr "JetBrains Rider"

#: ../../docs/tutorials/editor/external_editor.rst:49
msgid "``{project} --line {line} {file}``"
msgstr "``{project} --line {line} {file}``"

#: ../../docs/tutorials/editor/external_editor.rst:51
