msgid ""
"Clone the `winrt-mingw <https://github.com/godotengine/winrt-mingw>`_ "
"directory and navigate to it."
msgstr ""
"ໂຄລນ (Clone) ໄດເຣັກທໍຣີ `winrt-mingw <https://github.com/godotengine/winrt-"
"mingw>`_ ແລ້ວເຂົ້າໄປໃນນັ້ນ."

#: ../../docs/engine_details/development/compiling/compiling_for_windows.rst:375
msgid ""
