#: ../../docs/tutorials/scripting/c_sharp/diagnostics/GD0108.rst:42
#: ../../docs/tutorials/scripting/c_sharp/diagnostics/GD0109.rst:26
#: ../../docs/tutorials/scripting/c_sharp/diagnostics/GD0110.rst:28
#: ../../docs/tutorials/scripting/c_sharp/diagnostics/GD0111.rst:40
