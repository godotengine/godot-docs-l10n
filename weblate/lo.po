#: ../../docs/about/list_of_features.rst:744
msgid "Support for advertisements using third-party modules."
msgstr "ຮອງຮັບການສະແດງໂຄສະນາໂດຍໃຊ້ໂມດູນຈາກພາຍນອກ."

#: ../../docs/about/list_of_features.rst:745
msgid "Support for picture-in-picture mode on Android."
msgstr "ຮອງຮັບໂໝດຮູບຊ້ອນຮູບ (picture-in-picture) ໃນ Android."

#: ../../docs/about/list_of_features.rst:750
msgid "XR support (AR and VR)"
msgstr "ການຮອງຮັບ XR (AR ແລະ VR)"

#: ../../docs/about/list_of_features.rst:752
msgid "Out of the box :ref:`support for OpenXR <doc_setting_up_xr>`."
msgstr "ຮອງຮັບ :ref:`OpenXR <doc_setting_up_xr>` ໃນຕົວ."

#: ../../docs/about/list_of_features.rst:754
msgid ""
"Including support for popular desktop headsets like the Valve Index, WMR "
"headsets, and Quest over Link."
msgstr ""
"ລວມທັງການຮອງຮັບແວ່ນ XR ຍອດນິຍົມສຳລັບເດັສທັອບ ເຊັ່ນ Valve Index, ແວ່ນ WMR ແລະ Quest ຜ່ານ "
"Link."

#: ../../docs/about/list_of_features.rst:756
msgid ""
"Support for :ref:`Android-based headsets <doc_deploying_to_android>` using "
"OpenXR through a plugin."
msgstr ""
"ຮອງຮັບ :ref:`ແວ່ນ XR ທີ່ໃຊ້ Android <doc_deploying_to_android>` ໂດຍໃຊ້ OpenXR ຜ່ານປລັ"
"ກອິນ."

#: ../../docs/about/list_of_features.rst:758
msgid ""
"Including support for popular standalone headsets like the Meta Quest 1/2/3 "
"and Pro, Pico 4, Magic Leap 2, and Lynx R1."
msgstr ""
"ລວມທັງການຮອງຮັບແວ່ນແບບສະແຕນອະໂລນ (standalone) ຍອດນິຍົມ ເຊັ່ນ Meta Quest 1/2/3 ແລະ "
"Pro, Pico 4, Magic Leap 2 ແລະ Lynx R1."

#: ../../docs/about/list_of_features.rst:760
msgid "Out of the box limited support for visionOS Apple headsets."
msgstr "ຮອງຮັບແວ່ນ visionOS ຂອງ Apple ໃນລະດັບຈຳກັດ."

#: ../../docs/about/list_of_features.rst:762
msgid ""
"Currently only exporting an application for use on a flat plane within the "
"headset is supported. Immersive experiences are not supported."
msgstr ""
"ປະຈຸບັນຮອງຮັບພຽງແຕ່ການເອັກສະປອດແອັບພລິເຄຊັນເພື່ອໃຊ້ໃນພື້ນຜິວພຽງພາຍໃນແວ່ນເທົ່ານັ້ນ. ຍັງບໍ່ຮອງຮັບປະສົບກ"
"ານແບບ Immersive ຢ່າງເຕັມຮູບແບບ."

#: ../../docs/about/list_of_features.rst:765
msgid "Other devices supported through an XR plugin structure."
msgstr "ອຸປະກອນອື່ນໆ ທີ່ຮອງຮັບຜ່ານໂຄງສ້າງປລັກອິນ XR."

#: ../../docs/about/list_of_features.rst:766
msgid ""
"Various advanced toolkits are available that implement common features "
"required by XR applications."
msgstr ""
"ມີຊຸດເຄື່ອງມືຂັ້ນສູງຕ່າງໆ ທີ່ຊ່ວຍສ້າງຟີເຈີທົ່ວໄປທີ່ຈຳເປັນສຳລັບແອັບພລິເຄຊັນ XR."

#: ../../docs/about/list_of_features.rst:769
msgid "GUI system"
msgstr "ລະບົບ GUI"

#: ../../docs/about/list_of_features.rst:771
msgid ""
"Godot's GUI is built using the same Control nodes used to make games in "
"Godot. The editor UI can easily be extended in many ways using add-ons."
msgstr ""
"GUI ຂອງ Godot ຖືກສ້າງຂຶ້ນດ້ວຍໂນດ Control ແບບດຽວກັນກັບທີ່ໃຊ້ສ້າງເກມໃນ Godot. UI ຂອງຕົວແກ້ໄຂ"
"ສາມາດຂະຫຍາຍເພີ່ມເຕີມໄດ້ງ່າຍໆ ຫຼາຍຮູບແບບໂດຍໃຊ້ແອດອອນ (add-ons)."

#: ../../docs/about/list_of_features.rst:774
msgid "**Nodes:**"
msgstr "**ໂນດ (Nodes):**"

#: ../../docs/about/list_of_features.rst:776
msgid "Buttons."
msgstr "ປຸ່ມຕ່າງໆ."

#: ../../docs/about/list_of_features.rst:777
msgid "Checkboxes, check buttons, radio buttons."
msgstr ""
"ກ່ອງເລືອກ (Checkboxes), ປຸ່ມສະຫຼັບ (check buttons), ປຸ່ມເລືອກພຽງອັນດຽວ (radio buttons)."

#: ../../docs/about/list_of_features.rst:778
msgid ""
"Text entry using :ref:`class_LineEdit` (single line), :ref:`class_TextEdit` "
"(multiple lines), and :ref:`class_CodeEdit` (supports syntax highlighting, "
"line numbers, and more)."
msgstr ""
"ການປ້ອນຂໍ້ຄວາມໂດຍໃຊ້ :ref:`class_LineEdit` (ແຖວດຽວ), :ref:`class_TextEdit` (ຫຼາຍແຖ"
"ວ) ແລະ :ref:`class_CodeEdit` (ຮອງຮັບການເນັ້ນໄວຍາກອນ, ເລກແຖວ ແລະ ອື່ນໆ)."

#: ../../docs/about/list_of_features.rst:781
msgid ""
"Dropdown menus using :ref:`class_PopupMenu` and :ref:`class_OptionButton` "
"with support for an optional search bar."
msgstr ""
"ເມນູແບບເລືອກລົງ (Dropdown) ໂດຍໃຊ້ :ref:`class_PopupMenu` ແລະ "
":ref:`class_OptionButton` ພ້ອມຮອງຮັບແຖບຄົ້ນຫາ."

#: ../../docs/about/list_of_features.rst:783
msgid "Scrollbars."
msgstr "ແຖບເລື່ອນ (Scrollbars)."

#: ../../docs/about/list_of_features.rst:784
msgid "Labels."
msgstr "ປ້າຍຂໍ້ຄວາມ (Labels)."

#: ../../docs/about/list_of_features.rst:785
msgid ""
"RichTextLabel for :ref:`text formatted using BBCode "
"<doc_bbcode_in_richtextlabel>`, with support for animated custom effects."
msgstr ""
"RichTextLabel ສຳລັບ :ref:`ຂໍ້ຄວາມທີ່ຈັດຮູບແບບດ້ວຍ BBCode "
"<doc_bbcode_in_richtextlabel>`, ພ້ອມຮອງຮັບເອັບເຟັກເຄື່ອນໄຫວທີ່ກຳນົດເອງ."

#: ../../docs/about/list_of_features.rst:787
msgid "Trees (can also be used to represent tables)."
msgstr "ແບບຕົ້ນໄມ້ (Trees) (ສາມາດໃຊ້ເພື່ອສະແດງຂໍ້ມູນແບບຕາຕະລາງໄດ້)."

#: ../../docs/about/list_of_features.rst:788
msgid ""
"Color picker with RGB, HSV, and OKHSL modes, as well as custom color "
"palettes."
msgstr ""
"ຕົວເລືອກສີ (Color picker) ທີ່ຮອງຮັບໂໝດ RGB, HSV, OKHSL ແລະ ຈານສີທີ່ກຳນົດເອງ."

#: ../../docs/about/list_of_features.rst:789
msgid "Controls can be rotated and scaled."
msgstr "ສ່ວນຄວບຄຸມ (Controls) ສາມາດໝູນ ແລະ ປ່ຽນຂະໜາດໄດ້."

#: ../../docs/about/list_of_features.rst:790
msgid "Drag-and-drop support."
msgstr "ຮອງຮັບການລາກ ແລະ ວາງ (Drag-and-drop)."

#: ../../docs/about/list_of_features.rst:792
msgid "**Sizing:**"
msgstr "**ຂະໜາດ:**"

#: ../../docs/about/list_of_features.rst:794
msgid "Anchors to keep GUI elements in a specific corner, edge or centered."
msgstr ""
"ຈຸດຍຶດ (Anchors) ເພື່ອຮັກສາອົງປະກອບ GUI ໄວ້ໃນມຸມ, ຂອບ ຫຼື ເຄິ່ງກາງທີ່ກຳນົດ."

#: ../../docs/about/list_of_features.rst:795
msgid "Containers to place GUI elements automatically following certain rules."
msgstr ""
"ຄອນເທນເນີ (Containers) ເພື່ອຈັດວາງອົງປະກອບ GUI ອັດຕະໂນມັດຕາມກົດເກນທີ່ກຳນົດ."

#: ../../docs/about/list_of_features.rst:797
msgid ":ref:`Stack <class_BoxContainer>` layouts."
msgstr "ການຈັດວາງແບບ :ref:`ຊ້ອນກັນ (Stack) <class_BoxContainer>`."

#: ../../docs/about/list_of_features.rst:798
msgid ":ref:`Grid <class_GridContainer>` layouts."
msgstr "ການຈັດວາງແບບ :ref:`ຕາຕະລາງ (Grid) <class_GridContainer>`."

#: ../../docs/about/list_of_features.rst:799
msgid ""
":ref:`Flow <class_FlowContainer>` layouts (similar to autowrapping text)."
msgstr ""
"ການຈັດວາງແບບ :ref:`ໄຫຼ (Flow) <class_FlowContainer>` (ຄ້າຍຄືກັບການຕັດແຖວຂໍ້ຄວາມອັດຕະໂນ"
"ມັດ)."

#: ../../docs/about/list_of_features.rst:800
msgid ""
":ref:`Margin <class_MarginContainer>`, :ref:`centered "
"<class_CenterContainer>` and :ref:`aspect ratio "
"<class_AspectRatioContainer>` layouts."
msgstr ""
"ການຈັດວາງແບບ :ref:`ຂອບ (Margin) <class_MarginContainer>`, :ref:`ເຄິ່ງກາງ "
"<class_CenterContainer>` ແລະ :ref:`ຮັກສາອັດຕາສ່ວນ <class_AspectRatioContainer>`."

#: ../../docs/about/list_of_features.rst:802
msgid ":ref:`Draggable splitter <class_SplitContainer>` layouts."
msgstr "ການຈັດວາງແບບ :ref:`ຕົວແຍກທີ່ລາກໄດ້ <class_SplitContainer>`."

#: ../../docs/about/list_of_features.rst:803
msgid ":ref:`Foldable section <class_FoldableContainer>` layouts."
msgstr "ການຈັດວາງແບບ :ref:`ສ່ວນທີ່ພັບໄດ້ <class_FoldableContainer>`."

#: ../../docs/about/list_of_features.rst:805
msgid ""
"Scale to :ref:`multiple resolutions <doc_multiple_resolutions>` using the "
"``canvas_items`` or ``viewport`` stretch modes."
msgstr ""
"ປ່ຽນຂະໜາດຕາມ :ref:`ຫຼາຍຄວາມລະອຽດ <doc_multiple_resolutions>` ໂດຍໃຊ້ໂໝດການຍືດແບບ "
"``canvas_items`` ຫຼື ``viewport``."

#: ../../docs/about/list_of_features.rst:807
msgid ""
"Support any aspect ratio using anchors and the ``expand`` stretch aspect."
msgstr "ຮອງຮັບທຸກອັດຕາສ່ວນຈໍໂດຍໃຊ້ຈຸດຍຶດ (anchors) ແລະ ການຍືດແບບ ``expand``."

#: ../../docs/about/list_of_features.rst:809
msgid "**Theming:**"
msgstr "**ທີມ (Theming):**"

#: ../../docs/about/list_of_features.rst:811
msgid "Built-in theme editor."
msgstr "ຕົວແກ້ໄຂທີມໃນຕົວ."

#: ../../docs/about/list_of_features.rst:813
msgid "Generate a theme based on the current editor theme settings."
msgstr "ສ້າງທີມໂດຍອີງຕາມການຕັ້ງຄ່າທີມຂອງຕົວແກ້ໄຂໃນປະຈຸບັນ."

#: ../../docs/about/list_of_features.rst:815
msgid "Procedural vector-based theming using :ref:`class_StyleBoxFlat`."
msgstr ""
"ການສ້າງທີມແບບເວັກເຕີ (procedural vector-based) ໂດຍໃຊ້ :ref:`class_StyleBoxFlat`."

#: ../../docs/about/list_of_features.rst:817
msgid ""
"Supports rounded/beveled corners, drop shadows, per-border widths and "
"antialiasing."
msgstr ""
"ຮອງຮັບມຸມມົນ/ມຸມລຽງ, ເງົາ (drop shadows), ຄວາມກວ້າງຂອງແຕ່ລະຂອບ ແລະ ການຫຼຸດຮອຍຢັກ "
"(antialiasing)."

#: ../../docs/about/list_of_features.rst:819
msgid "Texture-based theming using :ref:`class_StyleBoxTexture`."
msgstr ""
"ການສ້າງທີມໂດຍໃຊ້ຮູບພາບ (texture-based) ໂດຍໃຊ້ :ref:`class_StyleBoxTexture`."

#: ../../docs/about/list_of_features.rst:821
msgid ""
"Godot's small distribution size can make it a suitable alternative to "
"frameworks like Electron or Qt."
msgstr ""
"ຂະໜາດໄຟລ໌ທີ່ນ້ອຍຂອງ Godot ເຮັດໃຫ້ມັນເປັນທາງເລືອກທີ່ເໝາະສົມແທນເຟຣມເວີກຄື Electron ຫຼື Qt."

