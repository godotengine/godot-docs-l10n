msgid "Environment variables"
msgstr "ຕົວປ່ຽນສະພາບແວດລ້ອມ (Environment variables)"

#: ../../docs/tutorials/export/exporting_for_windows.rst:99
#: ../../docs/tutorials/export/exporting_for_linux.rst:71
#: ../../docs/tutorials/export/exporting_for_macos.rst:238
#: ../../docs/tutorials/export/exporting_for_android.rst:170
#: ../../docs/tutorials/export/exporting_for_ios.rst:140
#: ../../docs/tutorials/export/exporting_for_web.rst:444
msgid ""
"You can use the following environment variables to set export options "
"outside of the editor. During the export process, these override the values "
"that you set in the export menu."
msgstr ""
"ທ່ານສາມາດໃຊ້ຕົວປ່ຽນສະພາບແວດລ້ອມຕໍ່ໄປນີ້ເພື່ອຕັ້ງຄ່າຕົວເລືອກການສົ່ງອອກຈາກພາຍນອກ editor. ໃນລະຫວ່າງ"
"ຂະບວນການສົ່ງອອກ, ຄ່າເຫຼົ່ານີ້ຈະຂຽນທັບຄ່າທີ່ທ່ານຕັ້ງໄວ້ໃນເມນູການສົ່ງອອກ."

#: ../../docs/tutorials/export/exporting_for_windows.rst:103
msgid "Windows export environment variables"
msgstr "ຕົວປ່ຽນສະພາບແວດລ້ອມການສົ່ງອອກ Windows"

#: ../../docs/tutorials/export/exporting_for_windows.rst:106
#: ../../docs/tutorials/export/exporting_for_linux.rst:78
#: ../../docs/tutorials/export/exporting_for_macos.rst:245
#: ../../docs/tutorials/export/exporting_for_android.rst:177
#: ../../docs/tutorials/export/exporting_for_ios.rst:147
#: ../../docs/tutorials/export/exporting_for_web.rst:451
msgid "Export option"
msgstr "ຕົວເລືອກການສົ່ງອອກ"

#: ../../docs/tutorials/export/exporting_for_windows.rst:107
#: ../../docs/tutorials/export/exporting_for_linux.rst:79
#: ../../docs/tutorials/export/exporting_for_macos.rst:246
#: ../../docs/tutorials/export/exporting_for_android.rst:178
#: ../../docs/tutorials/export/exporting_for_ios.rst:148
#: ../../docs/tutorials/export/exporting_for_web.rst:452
msgid "Environment variable"
msgstr "ຕົວປ່ຽນສະພາບແວດລ້ອມ"

#: ../../docs/tutorials/export/exporting_for_windows.rst:108
#: ../../docs/tutorials/export/exporting_for_linux.rst:80
#: ../../docs/tutorials/export/exporting_for_macos.rst:247
#: ../../docs/tutorials/export/exporting_for_android.rst:179
#: ../../docs/tutorials/export/exporting_for_ios.rst:149
