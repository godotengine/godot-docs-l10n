msgstr "Визначає змінну. Див. `Змінні`_."

#: ../../docs/tutorials/scripting/gdscript/gdscript_basics.rst:199
msgid "breakpoint"
msgstr "breakpoint"

#: ../../docs/tutorials/scripting/gdscript/gdscript_basics.rst:199
msgid ""
