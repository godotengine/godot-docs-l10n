msgid "SteamOS"
msgstr "SteamOS"

#: ../../docs/tutorials/platform/linux/wayland_x11.rst:33
msgid "Bazzite"
msgstr "Bazzite"

#: ../../docs/tutorials/platform/linux/wayland_x11.rst:34
