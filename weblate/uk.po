msgid "``200``"
msgstr "``200``"

#: ../../docs/tutorials/ui/gui_using_fonts.rst:593
msgid "Extra Light (Ultra Light)"
msgstr "Надлегкий (Ultra Light)"

#: ../../docs/tutorials/ui/gui_using_fonts.rst:595
msgid "``300``"
msgstr "``300``"

