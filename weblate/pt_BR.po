msgstr "Variáveis de ambiente para exportação iOS"

#: ../../docs/tutorials/export/exporting_for_ios.rst:151
msgid "Options / Application / Provisioning Profile UUID Debug"
msgstr "Options / Application / Provisioning Profile UUID Debug"

#: ../../docs/tutorials/export/exporting_for_ios.rst:152
msgid "``GODOT_IOS_PROVISIONING_PROFILE_UUID_DEBUG``"
msgstr "``GODOT_IOS_PROVISIONING_PROFILE_UUID_DEBUG``"

#: ../../docs/tutorials/export/exporting_for_ios.rst:153
