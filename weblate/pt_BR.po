msgid "``{col}``"
msgstr "``{coluna}``"

#: ../../docs/tutorials/editor/external_editor.rst:35
msgid "The column number of the error"
msgstr "O número da coluna do erro"

#: ../../docs/tutorials/editor/external_editor.rst:37
msgid "``{line}``"
msgstr "``{linha}``"

