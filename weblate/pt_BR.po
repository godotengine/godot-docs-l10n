#: ../../docs/about/list_of_features.rst:836
msgid ""
"Scenes and resources can be saved in :ref:`text-based "
"<doc_tscn_file_format>` or binary formats."
msgstr ""
"Cenas e recursos podem ser salvos como :ref:`texto <doc_tscn_file_format>` "
