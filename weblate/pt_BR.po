msgstr "Tamanho de fonte personalizado."

#: ../../docs/tutorials/ui/bbcode_in_richtextlabel.rst:865
msgid "**glyph_spacing**, **gl**"
msgstr "**glyph_spacing**, **gl**"

#: ../../docs/tutorials/ui/bbcode_in_richtextlabel.rst:873
msgid "Extra spacing for each glyph."
msgstr "Espaçamento extra para cada glifo."

#: ../../docs/tutorials/ui/bbcode_in_richtextlabel.rst:875
