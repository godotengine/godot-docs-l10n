msgid ""
":ref:`PackedVector3Array <class_PackedVector3Array>` "
"or :ref:`PackedVector2Array <class_PackedVector2Array>`"
msgstr ""

#: ../../docs/tutorials/3d/procedural_geometry/arraymesh.rst:38
msgid "``ARRAY_NORMAL``"
msgstr ""

#: ../../docs/tutorials/3d/procedural_geometry/arraymesh.rst:39
msgid ":ref:`PackedVector3Array <class_PackedVector3Array>`"
msgstr ""

#: ../../docs/tutorials/3d/procedural_geometry/arraymesh.rst:42
msgid "``ARRAY_TANGENT``"
msgstr ""

#: ../../docs/tutorials/3d/procedural_geometry/arraymesh.rst:43
msgid ""
":ref:`PackedFloat32Array <class_PackedFloat32Array>` "
"or :ref:`PackedFloat64Array <class_PackedFloat64Array>` of groups of 4 "
