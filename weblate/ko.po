msgid "ASK"
msgstr "ASK"

#: ../../docs/tutorials/i18n/localization_using_spreadsheets.rst:52
msgid "How are you?"
msgstr "How are you?"

#: ../../docs/tutorials/i18n/localization_using_spreadsheets.rst:52
