"`servers/rendering/renderer_rd/effects/fsr2.cpp <https://github.com/"
"godotengine/godot/blob/4.6/servers/rendering/renderer_rd/effects/fsr2.cpp>`__"
msgstr "https://github.com/godotengine/godot-demo-projects"

#: ../../docs/engine_details/architecture/internal_rendering_architecture.rst:573
msgid ""
"`servers/rendering/renderer_rd/shaders/effects/fsr2/ <https://github.com/"
"godotengine/godot/tree/master/servers/rendering/renderer_rd/shaders/effects/"
"fsr2>`__"
msgstr "https://github.com/godotengine/godot-demo-projects"

#: ../../docs/engine_details/architecture/internal_rendering_architecture.rst:574
