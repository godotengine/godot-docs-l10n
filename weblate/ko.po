msgstr "gl_PointSize"

#: ../../docs/tutorials/shaders/converting_glsl_to_godot_shaders.rst:99
msgid "POINT_SIZE"
msgstr "POINT_SIZE"

#: ../../docs/tutorials/shaders/converting_glsl_to_godot_shaders.rst:99
msgid "Size of Point primitive."
msgstr "점 프리미티브의 크기."

#: ../../docs/tutorials/shaders/converting_glsl_to_godot_shaders.rst:101
msgid "gl_PointCoord"
msgstr "gl_PointCoord"

#: ../../docs/tutorials/shaders/converting_glsl_to_godot_shaders.rst:101
msgid "POINT_COORD"
msgstr "POINT_COORD"

