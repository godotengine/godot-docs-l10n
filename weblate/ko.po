msgid "Operation"
msgstr "연산자"

#: ../../docs/tutorials/shaders/shader_reference/shading_language.rst:542
#: ../../docs/tutorials/shaders/shader_reference/shader_functions.rst:48
msgid "Equivalent Scalar Operation"
msgstr "동등한 스칼라 연산"

#: ../../docs/tutorials/shaders/shader_reference/shading_language.rst:544
msgid "``vec3(4, 5, 6) + 2``"
msgstr "``vec3(4, 5, 6) + 2``"

#: ../../docs/tutorials/shaders/shader_reference/shading_language.rst:544
