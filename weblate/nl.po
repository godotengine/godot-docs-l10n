msgid "(0, 0, 1)"
msgstr "(0, 0, 1)"

#: ../../docs/tutorials/3d/procedural_geometry/arraymesh.rst:339
msgid "(1, 0)"
msgstr "(1, 0)"

#: ../../docs/tutorials/3d/procedural_geometry/arraymesh.rst:343
msgid "(1, 0, 0)"
msgstr "(1, 0, 0)"

#: ../../docs/tutorials/3d/procedural_geometry/arraymesh.rst:344
msgid "(0, 1)"
msgstr "(0, 1)"

