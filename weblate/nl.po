#: ../../docs/tutorials/3d/global_illumination/reflection_probes.rst:78
#, fuzzy
msgid "Setting up a ReflectionProbe"
msgstr "De speler bewegen"

#: ../../docs/tutorials/3d/global_illumination/reflection_probes.rst:80
msgid "Add a :ref:`class_ReflectionProbe` node."
