msgstr ""

#: ../../docs/tutorials/3d/particles/turbulence.rst:116
msgid ""
"No displacement (left), displacement value of 5 (middle), displacement range "
"[-20, 20] (right)"
msgstr ""

#: ../../docs/tutorials/3d/particles/attractors.rst:4
