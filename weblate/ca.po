msgid "es"
msgstr "es"

#: ../../docs/tutorials/i18n/localization_using_spreadsheets.rst:48
#: ../../docs/tutorials/i18n/locales.rst:495
msgid "ja"
msgstr "ja"

#: ../../docs/tutorials/i18n/localization_using_spreadsheets.rst:50
msgid "GREET"
msgstr "GREET"

