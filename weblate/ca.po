#: ../../docs/tutorials/rendering/renderers.rst:183
msgid "Rendering cost"
msgstr "Renderitzat"

#: ../../docs/tutorials/rendering/renderers.rst:183
msgid "Low base cost, but high scaling cost."
msgstr "Baix cost base, però alt cost d'escala."

#: ../../docs/tutorials/rendering/renderers.rst:183
