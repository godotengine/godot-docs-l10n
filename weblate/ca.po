msgid "WAV IMA ADPCM, 44 kHz, mono"
msgstr "WAV IMA ADPCM, 44 kHz, mono"

#: ../../docs/tutorials/assets_pipeline/importing_audio_samples.rst:39
msgid "22 KB"
msgstr "22 KB"

