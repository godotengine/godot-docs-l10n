#: ../../docs/engine_details/class_reference/index.rst:139
#: ../../docs/engine_details/class_reference/index.rst:183
msgid "Tag and Description"
msgstr "Descripció"

#: ../../docs/tutorials/scripting/gdscript/gdscript_documentation_comments.rst:247
#: ../../docs/engine_details/class_reference/index.rst:139
#: ../../docs/engine_details/class_reference/index.rst:183
msgid "Result"
msgstr "Resultat"

#: ../../docs/tutorials/scripting/gdscript/gdscript_documentation_comments.rst:0
#: ../../docs/engine_details/class_reference/index.rst:0
msgid "``[Class]``"
msgstr "``[Class]``"

