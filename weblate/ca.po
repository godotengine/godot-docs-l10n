#: ../../docs/tutorials/editor/external_editor.rst:109
#: ../../docs/tutorials/scripting/c_sharp/c_sharp_basics.rst:72
#: ../../docs/tutorials/scripting/c_sharp/c_sharp_basics.rst:95
