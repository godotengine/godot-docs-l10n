msgstr "PascalCase"

#: ../../docs/tutorials/scripting/gdscript/gdscript_styleguide.rst:651
msgid "``class_name YAMLParser``"
msgstr "``class_name YAMLParser``"

#: ../../docs/tutorials/scripting/gdscript/gdscript_styleguide.rst:653
msgid "Node names"
msgstr "Noms de node"

#: ../../docs/tutorials/scripting/gdscript/gdscript_styleguide.rst:653
msgid "``Camera3D``, ``Player``"
msgstr "``Camera3D``, ``Reproductor``"

#: ../../docs/tutorials/scripting/gdscript/gdscript_styleguide.rst:655
msgid "``func load_level():``"
msgstr "``func load_level():``"

#: ../../docs/tutorials/scripting/gdscript/gdscript_styleguide.rst:657
