msgstr ""
"|editor| Démarrer le serveur de débogage de l'éditeur ( ``<protocol>://<host/"
"IP>[:<port>]``, par ex. ``tcp://127.0.0.1:6007``)"

#: ../../docs/tutorials/editor/command_line_tutorial.rst:78
msgid "``--dap-port <port>``"
msgstr "``--dap-port <port>``"

#: ../../docs/tutorials/editor/command_line_tutorial.rst:78
