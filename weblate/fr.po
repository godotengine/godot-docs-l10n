msgstr ""
"|editor| Démarrer le gestionnaire de projet, même si un projet est "
"autodétecté."

#: ../../docs/tutorials/editor/command_line_tutorial.rst:73
msgid "``--recovery-mode``"
msgstr "``--recovery-mode``"

#: ../../docs/tutorials/editor/command_line_tutorial.rst:73
