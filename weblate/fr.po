msgstr "|release| Utiliser le mode verbeux pour la sortie standard (stdout)."

#: ../../docs/tutorials/editor/command_line_tutorial.rst:57
msgid "``-q``, ``--quiet``"
msgstr "``-q``, ``--quiet``"

#: ../../docs/tutorials/editor/command_line_tutorial.rst:57
