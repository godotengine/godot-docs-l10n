#: ../../docs/tutorials/scripting/gdscript/gdscript_basics.rst:944
msgid ""
":ref:`PackedColorArray <class_PackedColorArray>`: An array of :ref:`Color "
"<class_Color>` values."
msgstr ""
":ref:`PackedColorArray <class_PackedColorArray>`: Un array di "
