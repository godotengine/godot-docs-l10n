msgstr ""
"Rete TCP di basso livello attraverso :ref:`class_StreamPeer` "
"e :ref:`class_TCPServer`."

#: ../../docs/about/list_of_features.rst:660
msgid ""
"Low-level UDP networking using :ref:`class_PacketPeer` "
"and :ref:`class_UDPServer`."
msgstr ""
"Rete UDP di basso livello attraverso :ref:`class_PacketPeer` "
"e :ref:`class_UDPServer`."

