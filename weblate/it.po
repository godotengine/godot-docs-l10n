msgstr ""
"Quando si compila Godot senza classi e funzioni deprecate, ovvero con "
"l'argomento ``deprecated=no`` per scons, anche le librerie gestite si devono "
"compilare senza dipendenze da codice deprecato. Ciò si ottiene passando "
"l'argomento ``--no-deprecated``:"

#: ../../docs/engine_details/development/compiling/compiling_with_dotnet.rst:148
msgid "Double Precision Support (REAL_T_IS_DOUBLE)"
msgstr "Supporto per la doppia precisione (REAL_T_IS_DOUBLE)"

#: ../../docs/engine_details/development/compiling/compiling_with_dotnet.rst:150
msgid ""
