msgstr "``vec3(4 + 2, 5 + 2, 6 + 2)``"

#: ../../docs/tutorials/shaders/shader_reference/shading_language.rst:546
msgid "``vec2(3, 4) * vec2(10, 20)``"
msgstr "``vec2(3, 4) * vec2(10, 20)``"

#: ../../docs/tutorials/shaders/shader_reference/shading_language.rst:546
msgid "``vec2(3 * 10, 4 * 20)``"
msgstr "``vec2(3 * 10, 4 * 20)``"

#: ../../docs/tutorials/shaders/shader_reference/shading_language.rst:548
