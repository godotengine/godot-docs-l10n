#: ../../docs/engine_details/development/compiling/cross-compiling_for_ios_on_linux.rst:108
msgid "Compiling Godot for iPhone"
msgstr "編譯 Godot 為 iPhone 版本"

#: ../../docs/engine_details/development/compiling/cross-compiling_for_ios_on_linux.rst:110
