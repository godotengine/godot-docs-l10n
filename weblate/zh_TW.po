msgstr "WAV 24 位元, 96 kHz, 立體聲"

#: ../../docs/tutorials/assets_pipeline/importing_audio_samples.rst:35
msgid "576 KB"
msgstr "576 KB"

#: ../../docs/tutorials/assets_pipeline/importing_audio_samples.rst:37
