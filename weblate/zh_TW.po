#: ../../docs/tutorials/shaders/visual_shaders.rst:148
msgid "Pink"
msgstr "粉紅色"

#: ../../docs/tutorials/shaders/visual_shaders.rst:149
msgid "A matrix, usually used to transform vertices."
msgstr "矩陣，通常用於變換頂點座標。"

#: ../../docs/tutorials/shaders/visual_shaders.rst:150
msgid "|transform|"
msgstr "|transform|"

#: ../../docs/tutorials/shaders/visual_shaders.rst:123
msgid "transform"
msgstr "矩陣"

#: ../../docs/tutorials/shaders/visual_shaders.rst:151
msgid "Sampler"
msgstr "取樣器"

#: ../../docs/tutorials/shaders/visual_shaders.rst:152
