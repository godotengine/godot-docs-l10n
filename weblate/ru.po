msgid "base_plan_id: The base plan ID of the target subscription"
msgstr "base_plan_id: ID базового плана целевой подписки"

#: ../../docs/tutorials/platform/android/android_in_app_purchases.rst:309
msgid "offer_id: The offer ID under the base plan (optional)"
msgstr "offer_id: ID предложения в рамках базового плана (необязательно)"

#: ../../docs/tutorials/platform/android/android_in_app_purchases.rst:310
msgid ""
"is_offer_personalized: Whether to enable personalized pricing (optional)"
msgstr ""
"is_offer_personalized: следует ли включить персонализированное "
