msgid "**Good**:"
msgstr "**טוב**:"

#: ../../docs/tutorials/scripting/gdscript/gdscript_styleguide.rst:140
#: ../../docs/tutorials/scripting/gdscript/gdscript_styleguide.rst:165
#: ../../docs/tutorials/scripting/gdscript/gdscript_styleguide.rst:203
