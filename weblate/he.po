#: ../../docs/tutorials/scripting/c_sharp/c_sharp_style_guide.rst:145
msgid "Insert a space:"
msgstr "יש להוסיף רווח:"

#: ../../docs/tutorials/scripting/c_sharp/c_sharp_style_guide.rst:147
