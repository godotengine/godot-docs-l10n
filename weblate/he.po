msgstr "``yaml_parser.gd``"

#: ../../docs/tutorials/scripting/gdscript/gdscript_styleguide.rst:658
msgid "Class names"
msgstr "שמות מחלקות"

#: ../../docs/tutorials/scripting/gdscript/gdscript_styleguide.rst:658
#: ../../docs/tutorials/scripting/gdscript/gdscript_styleguide.rst:660
