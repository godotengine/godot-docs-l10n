msgid "Chinese"
msgstr "סינית"

#: ../../docs/tutorials/export/exporting_projects.rst:126
#: ../../docs/tutorials/i18n/locales.rst:495
msgid "Japanese"
msgstr "יפנית"

#: ../../docs/tutorials/export/exporting_projects.rst:127
#: ../../docs/tutorials/i18n/locales.rst:573
msgid "Korean"
msgstr "קוריאנית"

#: ../../docs/tutorials/export/exporting_projects.rst:128
