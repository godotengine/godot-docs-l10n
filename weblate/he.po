msgstr "הערך השני שיש להכפיל."

#: ../../docs/tutorials/shaders/shader_reference/shader_functions.rst:1288
msgid "The value to be added to the result."
msgstr "הערך שיש להוסיף לתוצאה."

#: ../../docs/tutorials/shaders/shader_reference/shader_functions.rst:1291
msgid "The value of ``a * b + c``."
msgstr "הערך של ``a * b + c``."

#: ../../docs/tutorials/shaders/shader_reference/shader_functions.rst:1293
msgid "https://www.khronos.org/registry/OpenGL-Refpages/gl4/html/fma.xhtml"
msgstr "https://www.khronos.org/registry/OpenGL-Refpages/gl4/html/fma.xhtml"

