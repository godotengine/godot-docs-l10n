msgid "godot/modules/summator/tests/test_summator.h"
msgstr "கோடோட்/தொகுதிகள்/சம்மேட்டர்/சோதனைகள்/test_summator.h"

#: ../../docs/engine_details/engine_api/custom_modules_in_cpp.rst:545
